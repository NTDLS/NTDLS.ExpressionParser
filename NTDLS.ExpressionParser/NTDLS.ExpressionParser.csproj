<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Logo.ico</ApplicationIcon>
    <TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
    <Title>NTDLS.ExpressionParser</Title>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Copyright>Copyright © 2026 NetworkDLS</Copyright>
    <Description>
      A fast mathematics parsing engine for .NET. It supports expression nesting, variables, custom functions and all standard mathematical operations for integer, decimal (floating point), logic and bitwise. Expressions are compiled once and evaluated without allocating, and nulls are supported.
      In addition to custom functions and variables, these are built in: abs, acos, asin, atan, atan2, avg, ceil, clamp, cos, cosh, count, deg, e, exp, floor, hypot, if, log, log10, logn, max, min, modpow, not, pi, pow, prod, rad, rand, round, sign, sin, sinh, sqrt, sum, tan, tanh, trunc.
    </Description>
    <PackageProjectUrl>https://github.com/NTDLS/NTDLS.ExpressionParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NTDLS/NTDLS.ExpressionParser</RepositoryUrl>
    <PackageTags>expression-parser;math;math-parser;expression;equation;mathematics</PackageTags>
    <PackageReleaseNotes>
      Rewritten engine: expressions are parsed and compiled in a single pass to a program that evaluates without allocating (~44 ns with variables, ~0.5 μs to parse and evaluate a new expression).
      New: OperationCount, the == operator, unary ~ (bitwise NOT), show work lists every operation, and no limit on nesting depth.
      Many parsing bugs fixed, including variables replaced inside function names, functions without parameters, negated groups and variables, signs after comparisons, decimal precision, and operands separated only by whitespace.
      Behavior changes: operator precedence now follows C, syntax errors are thrown by the constructor, show work has a new format, and malformed input (e.g. "a b", "a &lt; = b", "max(1,)", "$") is rejected.
      See the release notes on GitHub for details.
    </PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>NetworkDLS</Authors>
    <Company>NetworkDLS</Company>
    <version>1.6.3</version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Images\128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

</Project>
